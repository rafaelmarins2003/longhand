{
  "name": "pi-longhand",
  "version": "0.1.0",
  "description": "A Pi mode where the agent investigates and you apply the code",
  "keywords": ["pi-package", "pi-extension", "coding-agent"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelmarins2003/longhand.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": [
    "index.ts",
    "guard.ts",
    "tools.ts",
    "prompt.ts",
    "delivery.ts",
    "README.md",
    "ROADMAP.md",
    "guard.test.ts",
    "delivery.test.ts"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types guard.test.ts delivery.test.ts"
  }
}
